LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_COMPLETION_MODEL=
LLM_EMBEDDING_MODEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Insurance Core
SMTP_ENCRYPTION=starttls
NATS_HOST=
